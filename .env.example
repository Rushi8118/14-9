# Server-only (never expose to Vite client / never commit)
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Analytics — see docs/seo/technical-audit.md finding C1.
# Production builds take the GA4 measurement id from the committed .env.production;
# leave these blank locally so initAnalytics() stays a no-op and no tag is loaded.
# Set one of them only to test tracking against your own property.
# GA4 measurement id, e.g. G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
# Google Tag Manager container id, e.g. GTM-XXXXXXX. Takes precedence over the GA4 id above.
VITE_GTM_ID=
