# Server-only (never expose to Vite client / never commit)
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# --- sitemap Edge Function -------------------------------------------------
# These are NOT read from this file. Set them on the function:
#   supabase secrets set SITE_URL=https://siddhivinayakoverseas.com
# Listed here so the full set of deployment-specific settings is in one place.
# See docs/dynamic-sitemap.md.
#
# SITE_URL                   required. Production origin for every <loc>. The
#                            function returns 500 without it rather than
#                            guessing a host and submitting the whole site to
#                            the wrong place.
# SITEMAP_CACHE_TTL          optional, default 60 (seconds). The publish-to-
#                            visible delay and the bound on sitemap staleness.
# SITEMAP_REVALIDATE_SECRET  optional. When set, a request carrying
#                            X-Sitemap-Revalidate: <secret> rebuilds at once.
#
# VITE_SUPABASE_URL above is also used at build time to fill
# %%SITEMAP_FUNCTION_ORIGIN%% in dist/.htaccess. The build fails if it is unset,
# because a literal token there would make sitemap-content.xml 404.

# Analytics — see docs/seo/technical-audit.md finding C1.
# Production builds take the GA4 measurement id from the committed .env.production;
# leave these blank locally so initAnalytics() stays a no-op and no tag is loaded.
# Set one of them only to test tracking against your own property.
# GA4 measurement id, e.g. G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=G-MDVF551H1C
# Google Tag Manager container id, e.g. GTM-XXXXXXX. Takes precedence over the GA4 id above.
VITE_GTM_ID=
