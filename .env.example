# Analytics — see docs/seo/technical-audit.md finding C1.
# Set ONE of these. With neither, initAnalytics() is a no-op and no tag is loaded,
# which is the correct behaviour for local development.
# GA4 measurement id, e.g. G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
# Google Tag Manager container id, e.g. GTM-XXXXXXX. Takes precedence over the GA4 id above.
VITE_GTM_ID=
