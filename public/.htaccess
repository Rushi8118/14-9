Options -Indexes -MultiViews
DirectoryIndex index.html
# Prerendered routes live in folders; serve them at the slash-less canonical URL instead of redirecting.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Preferred host: https://siddhivinayakoverseas.com (no www)
  # (also drops a trailing slash so www/contact/ needs one hop, not two)
  RewriteCond %{HTTP_HOST} ^www\.siddhivinayakoverseas\.com$ [NC]
  RewriteRule ^(.*?)/?$ https://siddhivinayakoverseas.com/$1 [R=301,L]

  # Old per-country post-study URLs (reported as Soft 404 / not indexed): move to the country's study page,
  # which covers post-study work rights for that country.
  RewriteRule ^post-study-work-visa/(uk|ireland|new-zealand|germany|australia|france|canada)$ /study-in-$1 [R=301,L]

  # Retired /countries/{slug} profiles. They duplicated /study-in-* and /work-visa/* for the same
  # query, had no inbound internal link, and shipped unpopulated Supabase fields as visible copy
  # ("No specific work criteria listed."). Each now points at whichever page actually answers the
  # intent. The /countries hub itself stays: it is a genuine directory into these pages.
  RewriteRule ^countries/(canada|australia|germany|new-zealand)$ /study-in-$1 [R=301,L]
  RewriteRule ^countries/japan$ /work-visa/japan [R=301,L]
  RewriteRule ^countries/united-arab-emirates$ /study-in-dubai [R=301,L]
  # Anything else under /countries/ (including the orphaned .../programs/... route) goes to the hub.
  RewriteRule ^countries/.+$ /countries [R=301,L]

  # /contact-us never existed as a page. Two blog posts link to it, so Googlebot
  # followed the link, hit the trailing-slash rule below, and landed on a 404 --
  # which is the "Not found (404)" and "Page with redirect" pair Search Console
  # reported on 23 Sept. The contact page is /contact. This catches the external
  # and already-crawled links; the links inside the two posts still need fixing
  # in the admin panel, because a redirect is a patch, not a correct link.
  RewriteRule ^contact-us/?$ /contact [R=301,L]

  # /signup never existed either -- the account route is /register. Search Console
  # reported www.siddhivinayakoverseas.com/signup as the property's only "Not
  # found (404)" on 5 Oct 2026, and nothing in this codebase links to it, so the
  # source is an external link or a typed URL rather than a bug to fix upstream.
  # A 301 passes whatever little signal it carries to the page it was meant to be
  # and empties the 404 report, which matters because a single 404 is easy to
  # mistake for a crawl problem when reading the report later.
  RewriteRule ^signup/?$ /register [R=301,L]

  # /sitemap-content.xml is generated from the database by the sitemap Edge
  # Function, so publishing a post reaches the sitemap without a build or an
  # upload. This is a redirect and not a proxy because mod_proxy is not
  # available on this hosting plan -- an [P] rule would 500. Google follows
  # redirects when fetching a sitemap.
  #
  # 302, not 301: the target moves if a runtime is ever put in front of the
  # domain, and crawlers cache a 301 hard. The origin is filled into dist/ at
  # build time by scripts/generate-sitemap.mjs -- the committed file keeps the
  # token so the Supabase project is not baked into git.
  RewriteRule ^sitemap-content\.xml$ %%SITEMAP_FUNCTION_ORIGIN%%/functions/v1/sitemap/sitemap-content.xml [R=302,L]

  # 2. Canonical URLs have no trailing slash (root excepted)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Homepage: "/" is a directory, so name its file explicitly or rule 6 would 404 it
  RewriteRule ^$ /index.html [L]

  # 3. Prerendered pages: /study-in-canada -> /study-in-canada/index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]

  # The client-route shell is an internal file, not a page
  RewriteCond %{THE_REQUEST} \s/app-shell\.html [NC]
  RewriteRule ^ - [R=404,L]

  # 4. Existing files (assets, sitemap.xml, robots.txt)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 5. Client-rendered routes: database-driven pages and the private app
  # They get app-shell.html: index.html without the homepage canonical/og:url, so an un-prerendered page
  # never tells Google it is a duplicate of the homepage. React sets the real canonical after rendering.
  # `countries` is not listed: /countries is prerendered (rule 3) and everything below it is
  # 301'd above, so nothing under it needs the shell any more.
  # E=APPSHELL:1 makes Apache emit X-App-Shell: 1 (see the mod_headers block
  # below). That header is how the Cloudflare SEO Worker tells "this URL fell
  # through to the shell and has no metadata" from "this URL was prerendered and
  # already has real metadata" -- a response header it can read before touching
  # the body, rather than sniffing the HTML. Rule 3 above never sets it, so a
  # prerendered page is passed through untouched. See workers/seo-head/.
  RewriteRule ^(blog|urgent-requirements)(/.*)?$ /app-shell.html [E=APPSHELL:1,L]
  # Private and account pages: never indexed
  RewriteRule ^(dashboard|admin|auth|login|register|forgot-password|reset-password|403)(/.*)?$ /app-shell.html [E=NOINDEX:1,L]

  # 6. Anything else does not exist: send a real 404 instead of a soft 404
  RewriteRule ^ - [R=404,L]
</IfModule>

ErrorDocument 404 /404/index.html

# Brotli compression (modern browsers)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Gzip compression (fallback)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache static assets aggressively
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresDefault "access plus 1 month"
  # Crawlers must see sitemap/robots changes quickly
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, follow" env=REDIRECT_NOINDEX
  Header set X-Robots-Tag "noindex, follow" env=NOINDEX
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  
  # Cache-Control for hashed assets (1 year)
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|avif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Always revalidate HTML so a new deploy's chunk names are picked up immediately.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"

    # Internal signal for the Cloudflare SEO Worker; not a crawler directive and
    # harmless when no Worker is deployed. Three states, deliberately:
    #
    #   0       this HTML is a prerendered page and already carries real
    #           metadata -- the Worker returns it untouched and makes no
    #           database call.
    #   1       this URL fell through to app-shell.html and has no metadata --
    #           the Worker looks the record up and injects it.
    #   absent  the origin is not this Apache config (local `vite preview`, or
    #           mod_headers unavailable) -- the Worker falls back to looking for
    #           the <meta name="x-app-shell"> marker in the body.
    #
    # The default is set first and overridden second, because a later `Header
    # set` replaces an earlier one. Stating 0 explicitly is what lets the Worker
    # skip the lookup for prerendered pages instead of having to parse them to
    # find out. REDIRECT_APPSHELL is the same flag seen after an internal
    # rewrite, which is how rule 5 reaches app-shell.html.
    Header set X-App-Shell "0"
    Header set X-App-Shell "1" env=APPSHELL
    Header set X-App-Shell "1" env=REDIRECT_APPSHELL
  </FilesMatch>
</IfModule>
