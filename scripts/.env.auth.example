# Credentials for `npm run auth:setup` (scripts/setup-auth-email.mjs).
#
# Copy to scripts/.env.auth.local and fill in. That file is git-ignored and must
# stay that way: an SMTP password in git history is a mail-relay takeover —
# it lets anyone send mail that passes your domain's SPF/DKIM checks.

# Supabase personal access token — https://supabase.com/dashboard/account/tokens
# Starts with "sbp_". Grants full control of your projects; treat it like a password.
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Defaults to the ref in supabase/.temp/linked-project.json, so this is optional.
SUPABASE_PROJECT_REF=ugvtrtlnufzkjgxhucji

# Used for the Site URL and every redirect URL. No trailing slash.
SITE_URL=https://siddhivinayakoverseas.com

# ---- SMTP -------------------------------------------------------------------
# Your mail provider's outgoing server. Common hosts:
#   Hostinger          smtp.hostinger.com        587
#   Zoho Mail          smtp.zoho.in              587
#   Google Workspace   smtp.gmail.com            587   (needs an App Password)
#   Microsoft 365      smtp.office365.com        587
#   Brevo              smtp-relay.brevo.com      587
#   Amazon SES         email-smtp.<region>.amazonaws.com  587
#
# Port 587 (STARTTLS) is the default. Use 465 only if your host requires it.
# With 2FA on, Google and Zoho reject the account password — create an app
# password instead.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=no-reply@siddhivinayakoverseas.com
SMTP_PASS=

# Shown as the From address and name. Defaults to SMTP_USER / "Siddhivinayak Overseas".
SMTP_SENDER_EMAIL=no-reply@siddhivinayakoverseas.com
SMTP_SENDER_NAME=Siddhivinayak Overseas
