# SEO audit scratch output. The reports, findings/ and onpage.json (the crawl
# baseline the before/after comparison is measured against) are committed; the
# raw HTML dumps, per-page JSON-LD dumps, screenshots and stderr files are
# ~10 MB of intermediate data and are not.
siddhivinayakoverseas.com-audit/*
!siddhivinayakoverseas.com-audit/*.md
!siddhivinayakoverseas.com-audit/onpage.json
!siddhivinayakoverseas.com-audit/audit-data.json
!siddhivinayakoverseas.com-audit/findings/

# Cloudflare Worker local secrets
.dev.vars
workers/**/.dev.vars
.wrangler/

# Generated by scripts/generate-sitemap.mjs into dist/ at build time.
# They were committed under public/ and rewritten by every build; not inputs.
/public/sitemap.xml
/public/sitemap-pages.xml
/public/sitemap-content.xml
